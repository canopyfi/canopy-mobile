# Canopy Mobile App Environment Configuration

# ===================
# Solana Configuration
# ===================

# Solana RPC URL
# For development, use devnet. For production, use mainnet-beta or a custom RPC.
EXPO_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Canopy Program ID
# The Solana program ID for the Canopy smart contract
EXPO_PUBLIC_CANOPY_PROGRAM_ID=11111111111111111111111111111111

# USDC Token Mint Address
# Devnet USDC: Gh9ZwEmdLJ8DscKNTkTqPbNwLNNBjuSzaG9Vp2KGtKJr
# Mainnet USDC: EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
EXPO_PUBLIC_USDC_MINT=Gh9ZwEmdLJ8DscKNTkTqPbNwLNNBjuSzaG9Vp2KGtKJr

# ===================
# Backend API Configuration
# ===================

# Backend API URL
# For development, use your local backend. For production, use your deployed API.
EXPO_PUBLIC_API_URL=http://localhost:3000

# API Key (optional, for authenticated endpoints)
EXPO_PUBLIC_API_KEY=

# ===================
# Matrica OAuth Configuration
# ===================

# Matrica OAuth Client ID
# Get this from the Matrica developer portal
EXPO_PUBLIC_MATRICA_CLIENT_ID=your_matrica_client_id

# Web Redirect URI for Matrica OAuth
# Matrica requires http/https URLs (doesn't support custom schemes like com.canopy.mobile://)
# This should point to your frontend's mobile callback endpoint
# For local dev with Android emulator, use your machine's network IP (not localhost)
# Example: http://192.168.1.100:3000/auth/mobile-callback
EXPO_PUBLIC_WEB_REDIRECT_URI=http://your-server:3000/auth/mobile-callback
